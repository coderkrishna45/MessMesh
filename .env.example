# =============================================================================
# MessMesh — Environment Variables
# Copy to `.env.local` for local dev, or set in Railway/Render dashboard for prod.
# Never commit real secrets.
# =============================================================================

# --- Database (required) ---
# Local:  mongodb://127.0.0.1:27017/messmesh
# Atlas:  mongodb+srv://USER:PASS@CLUSTER.mongodb.net/messmesh?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/messmesh

# --- NextAuth (required) ---
# Public URL of this app (no trailing slash). Must match the domain users visit.
# Dev:  http://localhost:3000
# Prod: https://your-app.up.railway.app   (or your custom domain)
NEXTAUTH_URL=http://localhost:3000

# Generate with:  openssl rand -base64 32
# Or PowerShell:  [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}) -as [byte[]])
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# --- Server (optional; platforms usually set PORT) ---
PORT=3000
# Must be 0.0.0.0 on Railway/Render so the platform can reach the process
HOSTNAME=0.0.0.0

# Extra Socket.io CORS origins (comma-separated). NEXTAUTH_URL is always allowed.
# SOCKET_CORS_ORIGIN=https://www.your-domain.com

# Only if frontend and socket server are different origins:
# NEXT_PUBLIC_SOCKET_URL=https://your-domain.com

# --- Google OAuth (optional — leave empty to disable Google login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudinary (optional — waste plate photo uploads) ---
# Create an *unsigned* upload preset in Cloudinary dashboard.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=messmesh_waste
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Production seed safety ---
# /api/seed WIPE the whole database. Keep false in production.
# One-time setup only: set ALLOW_DB_SEED=true, call seed with header, then set false again.
ALLOW_DB_SEED=false
# Optional dedicated seed secret (defaults to NEXTAUTH_SECRET if unset)
# SEED_SECRET=another-long-random-string
