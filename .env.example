# ================================================
# MessMesh - Environment Variables
# ================================================

# --- Database (Required) ---
# Local MongoDB (for development)
# MONGODB_URI=mongodb://127.0.0.1:27017/messmesh

# MongoDB Atlas (for production)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/messmesh?retryWrites=true&w=majority

# --- NextAuth (Required) ---
# Must match the exact domain users will visit (no trailing slash)
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_URL=https://your-app.up.railway.app

# Generate a strong secret using:
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
NEXTAUTH_SECRET=change-me-to-a-very-long-random-string

# --- Operator / account setup ---
# Required only for an explicitly unlocked, non-production legacy seed; never use the app auth secret.
SEED_SECRET=replace-with-a-different-random-operator-secret
# Optional invitation provider HTTP boundary (must accept {to, subject, setupUrl} JSON).
# MAIL_DELIVERY_URL=
# MAIL_DELIVERY_TOKEN=

# --- Separate public portfolio demo deployment ---
# Enable only in a deployment connected to a dedicated demo database.
# Do not copy the private MONGODB_URI into the demo service; omit it there.
DEMO_MODE=false
# DEMO_MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/messmesh_demo
# The private app database name only; never a URI or credential.
# REAL_DATABASE_NAME=messmesh
# NEXT_PUBLIC_DEMO_MODE=false
# Enable date simulation only in development or an explicitly configured demo.
ENABLE_DATE_SIMULATION=false
# NEXT_PUBLIC_ENABLE_DATE_SIMULATION=false
# Optional security integration-test database (must be isolated and named for tests).
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/messmesh_test
# Required by npm run demo:reset; set to YES_DEMO_RESET only for an intentional reset.
DEMO_RESET_CONFIRM=

# --- Server Configuration ---
PORT=3000
HOSTNAME=0.0.0.0

# --- Legacy non-production seed safety ---
# Keep false. The destructive endpoint refuses production and demo deployments.
ALLOW_DB_SEED=false

# --- Optional Features ---

# Cloudinary (for waste photo uploads)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=messmesh_waste

# Extra Socket.io CORS (if needed)
# SOCKET_CORS_ORIGIN=https://your-domain.com

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=