# ================================================
# MessMesh - Environment Variables
# ================================================

# --- Database (Required) ---
# Local MongoDB (for development)
# MONGODB_URI=mongodb://127.0.0.1:27017/messmesh

# MongoDB Atlas (for production)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/messmesh?retryWrites=true&w=majority

# --- NextAuth (Required) ---
# Must match the exact domain users will visit (no trailing slash)
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_URL=https://your-app.up.railway.app

# Generate a strong secret using:
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
NEXTAUTH_SECRET=change-me-to-a-very-long-random-string

# --- Server Configuration ---
PORT=3000
HOSTNAME=0.0.0.0

# --- Production Seed Safety ---
# Set to true only temporarily when seeding production data
ALLOW_DB_SEED=false

# --- Optional Features ---

# Cloudinary (for waste photo uploads)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=messmesh_waste

# Extra Socket.io CORS (if needed)
# SOCKET_CORS_ORIGIN=https://your-domain.com

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=